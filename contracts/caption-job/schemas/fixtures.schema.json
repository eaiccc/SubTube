{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contractVersion", "kind", "cases"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "kind": {
      "enum": [
        "normal_flow",
        "failure_paths",
        "polling_lifecycle",
        "identity_and_retry",
        "snapshot_ordering",
        "sentence_fallback"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case"],
        "properties": {
          "case": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": false
}
