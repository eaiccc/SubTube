{
  "contractVersion": "1.0.0",
  "kind": "preflight",
  "cases": [
    {
      "case": "public_captioned_english_900_seconds_is_accepted",
      "input": {
        "url": "https://youtu.be/Boundary900?si=tracking",
        "facts": {
          "visibility": "public",
          "isLive": false,
          "embeddable": true,
          "durationSeconds": 900,
          "sourceLanguage": "en",
          "captions": { "available": true, "parseable": true, "language": "en" }
        }
      },
      "expected": {
        "accepted": true,
        "response": {
          "status": 202,
          "bodySchema": "ProcessingJob",
          "body": {
            "jobId": "job-url-preflight-001",
            "videoId": "Boundary900",
            "title": "Boundary fixture",
            "duration": 900,
            "status": "queued",
            "errorCode": null,
            "errorMessageKey": null,
            "retryable": false,
            "learningDataPath": null,
            "updatedAt": "2026-08-26T02:00:00Z"
          }
        }
      },
      "expectedEffects": {
        "jobCreated": true,
        "jobIdReturned": true,
        "sourceMetadataCalls": 1,
        "captionAvailabilityCalls": 1,
        "captionPipelineStarts": 0,
        "translationCalls": 0,
        "audioDownloads": 0,
        "sttCalls": 0
      }
    },
    {
