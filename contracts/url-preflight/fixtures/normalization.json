{
  "contractVersion": "1.0.0",
  "kind": "normalization",
  "cases": [
    {
      "case": "watch_url_strips_tracking_and_fragment",
      "input": { "url": "https://www.youtube.com/watch?v=AbCdEf12_-3&utm_source=test&si=tracking#chapter" },
      "expected": {
        "accepted": true,
        "videoId": "AbCdEf12_-3",
        "canonicalUrl": "https://www.youtube.com/watch?v=AbCdEf12_-3",
        "idempotencyFingerprintUrl": "https://www.youtube.com/watch?v=AbCdEf12_-3&utm_source=test&si=tracking#chapter"
      },
      "expectedEffects": {
        "jobCreated": false,
        "jobIdReturned": false,
        "sourceMetadataCalls": 0,
        "captionAvailabilityCalls": 0,
        "captionPipelineStarts": 0,
        "translationCalls": 0,
        "audioDownloads": 0,
        "sttCalls": 0
      }
    },
    {
      "case": "short_url_strips_tracking",
      "input": { "url": "https://youtu.be/AbCdEf12_-3?si=tracking&t=12" },
      "expected": {
        "accepted": true,
        "videoId": "AbCdEf12_-3",
        "canonicalUrl": "https://www.youtube.com/watch?v=AbCdEf12_-3",
        "idempotencyFingerprintUrl": "https://youtu.be/AbCdEf12_-3?si=tracking&t=12"
      },
      "expectedEffects": {
        "jobCreated": false,
