  "qualityPlan": {
    "segmentsPerVideo": 10,
    "selectionRule": "After segmentation is frozen, select the segment nearest each 5%, 15%, 25%, 35%, 45%, 55%, 65%, 75%, 85% and 95% point by segment ordinal; do not hand-pick easy sentences.",
    "reviewers": [
      {
        "id": "codex-hermione-pro",
        "locale": "zh-Hant-TW",
        "role": "primary independent translation-quality scorer"
      },
      {
        "id": "codex-mcgonagall-review-pro",
        "locale": "zh-Hant-TW",
        "role": "secondary independent translation-quality scorer"
      }
    ],
    "reviewRule": "Both reviewers score all 200 sampled segments independently before seeing the other score. They do not edit translations during scoring.",
    "rubric": [
      {"score": 1, "label": "Unusable", "definition": "Meaning is wrong or missing enough that the learner is materially misled."},
      {"score": 2, "label": "Major repair", "definition": "Some meaning survives, but major omissions, additions, terminology or grammar errors require rewriting."},
      {"score": 3, "label": "Understandable", "definition": "Core meaning is understandable, but wording is notably unnatural or contains non-material inaccuracies."},
      {"score": 4, "label": "Acceptable", "definition": "Meaning is correct and complete, with natural enough Taiwan Traditional Chinese and only cosmetic issues."},
      {"score": 5, "label": "Excellent", "definition": "Accurate, complete and idiomatic Taiwan Traditional Chinese requiring no meaningful edit."}
    ],
    "acceptableScoreMinimum": 4,
    "aggregateAcceptanceMinimum": 0.9,
    "expectedRatingCount": 400,
    "gateFormula": "count(score >= 4) / 400 >= 0.90",
    "disagreementRule": "Record both scores. A difference greater than 1 is flagged for PO adjudication but neither original score is replaced in the launch metric.",
    "executionStatus": "NOT RUN"
  },
